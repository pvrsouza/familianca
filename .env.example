# Copie para .env (fora do git) e preencha. O docker compose lê este arquivo sozinho.

# --- Primeiro ADMIN da plataforma (opcional) -------------------------------------------------------------------
# Criado no startup só quando não existe nenhum usuário, com uma família própria. Senha de 12 a 64 caracteres.
# Sem as duas variáveis, ninguém é criado: as famílias nascem pelo cadastro público (POST /api/cadastro).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NOME=Administrador

# --- Banco ------------------------------------------------------------------------------------------------------
# DB_URL=jdbc:postgresql://postgres:5432/familianca
# DB_USER=familianca_app
# DB_PASSWORD=
# Usuário das migrations (Flyway), dono do schema. Sem ele, o Flyway usa DB_USER.
# FLYWAY_USER=familianca_ddl
# FLYWAY_PASSWORD=

# --- Sessão e acesso --------------------------------------------------------------------------------------------
# SESSAO_COOKIE_SEGURO=true
# SESSAO_TIMEOUT_WEB=30m
# SESSAO_DURACAO_MAXIMA=12h
# API_MAX_REQUISICOES=300
# API_JANELA=1m
# Chave que cifra os segredos do MFA no banco (produção: openssl rand -hex 32). Trocar invalida os MFAs ativos.
# MFA_CHAVE=
# FRONTEND_ORIGIN=https://app.familianca.com.br
# LOGIN_MAX_TENTATIVAS=5
# LOGIN_JANELA=15m
# Link enviado nos convites: <CONVITE_URL_BASE>/<token>
# CONVITE_URL_BASE=http://localhost:5174/convite

# --- Assinatura -------------------------------------------------------------------------------------------------
# Dias de teste do plano completo para uma família nova.
# ASSINATURA_DIAS_TESTE=30
