# Copie para .env nesta pasta (fora do git) e preencha. Lido pelo compose.prod.yaml.

# Senhas do Postgres, uma por usuário (gerar cada uma com: openssl rand -hex 32). Valem só na primeira subida.
POSTGRES_PASSWORD=
FLYWAY_PASSWORD=
DB_PASSWORD=

# Opcional. Chave que cifra os segredos da verificação em duas etapas (openssl rand -hex 32). Vazia: o MFA fica
# desligado e o resto funciona. Depois de definida, não troque nem apague: invalida os MFAs já ativos (e quem tem
# MFA ativo não entra sem ela).
MFA_CHAVE=

# Versão (tag) da imagem do app. Cada deploy gera uma tag nova; o rollback volta para a anterior (README, "Rollback").
APP_VERSAO=latest

# Link dos convites: <CONVITE_URL_BASE>/<token> (rota do front).
CONVITE_URL_BASE=https://app.familianca.com.br/convite

# ADMIN da plataforma (opcional): só no primeiro start, com o banco vazio. Depois, apague as duas.
ADMIN_EMAIL=
ADMIN_PASSWORD=
